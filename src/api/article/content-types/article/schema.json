{
  "kind": "collectionType",
  "collectionName": "api_articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article",
    "description": ""
  },
  "options": {
    "draftAndPublish": true,
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetAttribute": "title",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "image": {
      "type": "media",
      "allowedTypes": [
        "images"
      ],
      "multiple": false
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::archive.archive",
      "inversedBy": "articles"
    },
    "chapters": {
      "type": "component",
      "repeatable": true,
      "component": "shared.chapter",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}